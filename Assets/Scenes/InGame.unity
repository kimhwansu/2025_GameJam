  m_text: "<\uD29C\uD1A0\uB9AC\uC5BC>\n\uACB0\uC81C\uB97C \uC644\uBCBD\uD558\uAC8C
    \uCC98\uB9AC\uD574\uC57C \uC2DC\uAE09\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC1C\uC218\uC640
    \uC885\uB958\uB97C \uC815\uD655\uD788 \uD655\uC778\uD558\uC138\uC694.\n\n\uC9C4\uC0C1
    \uC190\uB2D8\uB4E4\uC740 \n\uC790\uC2E0\uC758 \uB9D0\uC744 \uB05D\uAE4C\uC9C0
    \uB4E4\uC5B4\uC8FC\uC9C0 \uC54A\uC73C\uBA74 \uACB0\uC81C\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uC2E4\uC218
    \uC5C6\uC774 \uB3C8\uC744 \uBAA8\uC73C\uACE0,\n\uB9DD\uC124\uC774\uC9C0 \uB9D0\uACE0
    \uAC8C\uC784\uC5D0 \uD22C\uC790\uD558\uC138\uC694.\n\n\u201C\uC774\uAC74 \uB2E8\uC21C\uD55C
    \uC54C\uBC14\uAC00 \uC544\uB2C8\uC57C.\n<color=#E06C75>\uC0AC\uB791\uD558\uB294
    \uB108</color>\uB97C \uC704\uD574 \uC900\uBE44\uD55C \uB9C8\uC9C0\uB9C9 \uB3C4\uC804.\u201D"
