  m_text: "\uB0B4\uAC00 10\uB144 \uB3D9\uC548 \uD568\uAED8\uD574\uC628 RPG \uAC8C\uC784\uC774\r\n\uC5B4\uB290
    \uB0A0 \uAC11\uC790\uAE30 \uACF5\uC9C0\uB97C \uC62C\uB838\uB2E4.\r\n\r\n\u201C<color=red>\uC77C\uC8FC\uC77C
    \uB4A4, \uC11C\uBC84 \uC885\uB8CC.</color>\u201D\r\n\r\n\uB204\uAD6C\uBCF4\uB2E4
